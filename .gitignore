# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release
dist/
# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# dotenv environment variables file
.env
.env.test

# Next.js build output
.next

# JetBrains
.idea

# VSCode
.vscode

# Packge lock
package-lock.json

# Local-only operational scripts. These are generated with real credentials
# pasted in (see B1: rotating the Firebase service-account key), so they must
# never reach the repo — which is public.
*.local.sh

# Service-account key files, in any of the shapes Google hands them out as.
*serviceaccount*.json
*service-account*.json
*-adminsdk-*.json
