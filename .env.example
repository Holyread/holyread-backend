PORT=8000
AWS_SECRET=
KINDLE_SMTP_EMAIL=
KINDLE_SMTP_SECRET=
SMTP_SECRET=
AWS_ACCESSKEY=
STRIPE_SECRET=
NODE_ENV=local
DBURL=mongodb://localhost:27017/test

# Firebase service account (Admin SDK). Download the JSON from
# GCP IAM -> Service Accounts -> Keys and copy the fields across.
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes and be quoted.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# Boot-time side effects. Default on only in the deployed environments
# (NODE_ENV=production|development). Leave these off locally: the scripts run
# write-migrations against DBURL and the cron jobs email/notify real users.
# RUN_CRON=true is not on its own enough to start jobs: src/cron/cronGuard.ts
# also requires NODE_ENV to be production or development.
RUN_STARTUP_SCRIPTS=false
RUN_CRON=false

# B5: reports confirmed App Store subscriptions to GA4/Firebase Analytics so
# subscribe rate can be attributed to a traffic source. Generate the secret at
# Firebase console -> Project settings -> Data Streams -> your iOS stream ->
# Measurement Protocol API secrets. GA_FIREBASE_APP_ID_IOS is the "App ID" on
# that same app's settings page (format 1:XXXXXXXXXX:ios:XXXXXXXXXXXXXXXX).
# Only an iOS app is registered in Firebase today; Android subscriptions won't
# be reported until an Android app + secret are added.
GA_FIREBASE_APP_ID_IOS=
GA_MEASUREMENT_API_SECRET=
