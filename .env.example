PORT=8000
AWS_SECRET=
KINDLE_SMTP_EMAIL=
KINDLE_SMTP_SECRET=
SMTP_SECRET=
AWS_ACCESSKEY=
STRIPE_SECRET=
NODE_ENV=local
DBURL=mongodb://localhost:27017/test

# Firebase service account (Admin SDK). Download the JSON from
# GCP IAM -> Service Accounts -> Keys and copy the fields across.
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes and be quoted.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# Boot-time side effects. Default on only in the deployed environments
# (NODE_ENV=production|development). Leave these off locally: the scripts run
# write-migrations against DBURL and the cron jobs email/notify real users.
# RUN_CRON=true is not on its own enough to start jobs: src/cron/cronGuard.ts
# also requires NODE_ENV to be production or development.
RUN_STARTUP_SCRIPTS=false
RUN_CRON=false
